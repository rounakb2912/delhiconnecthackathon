# ========================================================
# Delhi Bus Traffic Model & Journey Planner Environment Config
# ========================================================

# 1. Delhi Open Transit Data (OTD) API Key
# Request a free API key at: https://otd.delhi.gov.in/ (Real Time Data)
# Used to fetch live GPS positions of Delhi DTC & DIMTS buses.
OTD_API_KEY=

# 2. CartoDB API Key (Optional)
# Obtain from: https://carto.com/basemaps/apikey/
# Used if you wish to use CartoDB Positron / Dark Matter basemaps.
CARTO_API_KEY=

# 3. Mapbox Access Token (Optional)
# Obtain from: https://account.mapbox.com/
# Used for high-res Mapbox Streets and Satellite layers.
MAPBOX_API_KEY=
